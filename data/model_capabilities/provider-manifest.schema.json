{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.smart-canvas/schema/provider-manifest.schema.json",
  "title": "智能画布第三方平台 Provider Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "transport", "catalog", "families"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "name_en": {"type": "string", "maxLength": 80},
        "version": {"type": "string", "minLength": 1, "maxLength": 40},
        "maintainer": {"type": "string", "maxLength": 120},
        "docs_url": {"type": "string", "format": "uri"}
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["http", "local_cli"]},
        "protocol": {"enum": ["openai", "gemini", "custom", "local_cli"]},
        "base_url": {"type": "string"},
        "allowed_hosts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["bearer", "header", "query", "none", "cli_login"]},
        "field": {"type": "string", "maxLength": 80},
        "prefix": {"type": "string", "maxLength": 40}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["endpoint", "static", "cli"]},
        "endpoint": {"type": "string"},
        "items_path": {"type": "string"},
        "id_path": {"type": "string"},
        "name_path": {"type": "string"},
        "output_type_path": {"type": "string"}
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family_id", "display_name", "node_type", "variants"],
        "properties": {
          "family_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
          "node_type": {"enum": ["text_generation", "image_generation", "video_generation", "audio_generation", "music_generation"]},
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["variant_id", "model_id", "operation", "inputs", "parameters", "request_mapping", "output", "evidence"],
              "properties": {
                "variant_id": {"type": "string", "minLength": 1, "maxLength": 120},
                "model_id": {"type": "string", "minLength": 1, "maxLength": 240},
                "endpoint": {"type": "string", "maxLength": 500},
                "operation": {"type": "string", "minLength": 1, "maxLength": 120},
                "inputs": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": ["media_type", "min", "max", "role"],
                    "properties": {
                      "media_type": {"enum": ["text", "image", "video", "audio"]},
                      "min": {"type": "integer", "minimum": 0},
                      "max": {"type": "integer", "minimum": 0},
                      "role": {"type": "string", "minLength": 1},
                      "min_chars": {"type": "integer", "minimum": 0},
                      "max_chars": {"type": "integer", "minimum": 1},
                      "min_bytes": {"type": "integer", "minimum": 0},
                      "max_bytes": {"type": "integer", "minimum": 1},
                      "min_width": {"type": "integer", "minimum": 1},
                      "max_width": {"type": "integer", "minimum": 1},
                      "min_height": {"type": "integer", "minimum": 1},
                      "max_height": {"type": "integer", "minimum": 1},
                      "min_pixels": {"type": "integer", "minimum": 1},
                      "max_pixels": {"type": "integer", "minimum": 1},
                      "max_aspect_ratio": {"type": "number", "minimum": 1},
                      "min_duration_seconds": {"type": "number", "minimum": 0},
                      "max_duration_seconds": {"type": "number", "minimum": 0},
                      "max_total_duration_seconds": {"type": "number", "minimum": 0}
                    }
                  }
                },
                "parameters": {"type": "object"},
                "request_mapping": {"type": "object", "additionalProperties": {"type": "string"}},
                "output": {"type": "object"},
                "evidence": {
                  "type": "object",
                  "required": ["level", "source"],
                  "properties": {
                    "level": {"enum": ["runtime_verified", "official_schema", "official_documented", "model_card_only", "unknown"]},
                    "source": {"type": "string", "minLength": 1},
                    "checked_at": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "task_protocol": {"type": "object"},
    "errors": {"type": "object"},
    "security": {"type": "object"}
  }
}
